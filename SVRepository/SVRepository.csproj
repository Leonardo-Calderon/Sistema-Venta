<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>SVRepository.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.SqlClient: Proporciona funcionalidad para conectarse y trabajar con SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <!-- Microsoft.Extensions.Configuration: Permite la configuración de la aplicación y acceso a connection strings -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.2" />
    <!-- Microsoft.Extensions.DependencyInjection: Implementa el patrón de inyección de dependencias -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3" />
  </ItemGroup>

</Project>
