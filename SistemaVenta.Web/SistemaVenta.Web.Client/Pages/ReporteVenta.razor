@page "/reporteventa"
@using Shared.DTOs
@using SistemaVenta.Web.Client.Services.Interfaces
@inject IVentaService ventaService
@inject HttpClient Http
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h5 class="m-0 font-weight-bold text-primary">Reporte de Ventas</h5>
    </div>
    <div class="card-body">
        <div class="row align-items-end mb-3">
            <div class="col-sm-6 col-md-3 mb-2 mb-md-0">
                <label class="form-label">Fecha Inicio:</label>
                <input type="date" class="form-control" @bind="fechaInicio" />
            </div>
            <div class="col-sm-6 col-md-3 mb-2 mb-md-0">
                <label class="form-label">Fecha Fin:</label>
                <input type="date" class="form-control" @bind="fechaFin" />
            </div>
            <div class="col-sm-6 col-md-3 mt-2 mt-md-0">
                <button type="button" class="btn btn-primary w-100" @onclick="BuscarReporte" disabled="@cargando">
                    @if (cargando)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="ms-2">Buscando...</span>
                    }
                    else
                    {
                        <i class="oi oi-magnifying-glass"></i>
                        <span>Buscar</span>
                    }
                </button>
            </div>
            <div class="col-sm-6 col-md-3 mt-2 mt-md-0">
                <button class="btn btn-success w-100" @onclick="ExportarAExcel"
                        disabled="@(cargando || exportando || listaReporte == null || !listaReporte.Any() || module is null)">
                    @if (exportando)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="ms-2">Exportando...</span>
                    }
                    else
                    {
                        <i class="oi oi-document"></i>
                        <span>Exportar a Excel</span>
                    }
                </button>
            </div>
        </div>

        @if (cargando)
        {
            <div class="d-flex justify-content-center mt-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else if (listaReporte != null)
        {
            <div class="table-responsive mt-3">
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Numero Venta</th>
                            <th>Usuario Registro</th>
                            <th>Fecha Registro</th>
                            <th>Producto</th>
                            <th>Precio Compra</th>
                            <th>Precio Venta</th>
                            <th>Cantidad</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (listaReporte.Any())
                        {
                            @foreach (var item in listaReporte)
                            {
                                <tr>
                                    <td>@item.NumeroVenta</td>
                                    <td>@item.NombreUsuario</td>
                                    <td>@item.FechaRegistro</td>
                                    <td>@item.Producto</td>
                                    <td>$@item.PrecioCompra?.ToString("N2")</td>
                                    <td>$@item.PrecioVenta?.ToString("N2")</td>
                                    <td>@item.Cantidad</td>
                                    <td>$@item.PrecioTotal?.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">No se encontraron resultados para el rango de fechas seleccionado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private DateTime fechaInicio = DateTime.Now;
    private DateTime fechaFin = DateTime.Now;
    private List<ReporteVentaDTO>? listaReporte = null;
    private bool cargando = false;
    private bool exportando = false;

    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/util.js");
            StateHasChanged();
        }
    }

    private async Task BuscarReporte()
    {
        cargando = true;
        listaReporte = null;

        var fInicio = fechaInicio.ToString("dd-MM-yyyy");
        var fFin = fechaFin.ToString("dd-MM-yyyy");

        try
        {
            listaReporte = await ventaService.Reporte(fInicio, fFin);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al buscar el reporte: {ex.Message}");
            listaReporte = new List<ReporteVentaDTO>();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ExportarAExcel()
    {
        if (module is null || listaReporte is null || !listaReporte.Any()) return;

        exportando = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/Ventas/GenerarReporteExcel", listaReporte);

            if (response.IsSuccessStatusCode)
            {

                var fileBytes = await response.Content.ReadAsByteArrayAsync();
                var base64String = Convert.ToBase64String(fileBytes);
                await module.InvokeVoidAsync("saveAsFile", $"ReporteVentas_{DateTime.Now:yyyyMMdd}.xlsx", base64String);
            }
            else
            {
                Console.WriteLine("Error al generar el reporte en el servidor.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al exportar: {ex.Message}");
        }
        finally
        {
            exportando = false;
        }
    }


    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            await module.DisposeAsync();
        }
    }
}